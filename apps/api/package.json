{
  "name": "@nexacrm/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node -e \"['tsconfig.tsbuildinfo','tsconfig.build.tsbuildinfo'].forEach(f=>{try{require('fs').unlinkSync(f)}catch{}})\" && prisma generate",
    "build": "nest build",
    "start": "prisma migrate deploy && node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "create-super-admin": "ts-node src/scripts/create-super-admin.ts"
  },
  "dependencies": {
