// ─────────────────────────────────────────────
// prisma/schema.prisma — NexaCRM
// ─────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

enum WorkspaceMemberRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  SALES_AGENT
  SUPPORT_AGENT
  VIEWER
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
  ABANDONED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  SPAM
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  SCHEDULED
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACTS_CARD
  TEMPLATE
  INTERACTIVE
  SYSTEM
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NotificationType {
  NEW_MESSAGE
  NEW_ASSIGNMENT
  TASK_DUE
  DEAL_STAGE_CHANGED
  LEAD_ASSIGNED
  MENTION
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  EXPORT
  IMPORT
  SETTINGS_CHANGED
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  URL
  EMAIL
  PHONE
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  GEMINI
}

enum LeadSource {
  WHATSAPP
  WEB_FORM
  MANUAL
  IMPORT
  API
  REFERRAL
  EMAIL
  SOCIAL
  OTHER
}

// ─────────────────────────────────────────────
// WORKSPACE & USERS
// ─────────────────────────────────────────────

model Workspace {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  logoUrl      String?
  primaryColor String?   @default("#6366f1")
  timezone     String    @default("UTC")
  currency     String    @default("USD")
  language     String    @default("en")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  members          WorkspaceMember[]
  contacts         Contact[]
  leads            Lead[]
  deals            Deal[]
  pipelines        Pipeline[]
  dealPipelines    DealPipeline[]
  conversations    Conversation[]
  tasks            Task[]
  calendarEvents   CalendarEvent[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  settings         WorkspaceSettings?
  customFields     CustomFieldDefinition[]
  quickReplies     QuickReply[]
  messageTemplates MessageTemplate[]
  broadcasts       Broadcast[]
  aiUsageLogs      AiUsageLog[]
  apiKeys          ApiKey[]
  tags             Tag[]
  labels           Label[]
  departments      Department[]
  teams            Team[]
  invitations      WorkspaceInvitation[]

  @@index([slug])
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String?
  firstName     String
  lastName      String
  avatarUrl     String?
  phone         String?
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  totpSecret    String?
  totpEnabled   Boolean    @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspaceMembers WorkspaceMember[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  assignedLeads    Lead[]          @relation("LeadAssignee")
  assignedDeals    Deal[]          @relation("DealAssignee")
  assignedConvs    Conversation[]  @relation("ConversationAssignee")
  tasks            Task[]          @relation("TaskAssignee")
  createdTasks     Task[]          @relation("TaskCreator")
  notifications    Notification[]
  messages         Message[]       @relation("MessageSender")
  calendarEvents   CalendarEvent[]

  @@index([email])
}

model WorkspaceMember {
  id          String              @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole @default(SALES_AGENT)
  isActive    Boolean             @default(true)
  joinedAt    DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams      TeamMember[]
  department DepartmentMember[]

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String              @id @default(uuid())
  workspaceId String
  email       String
  role        WorkspaceMemberRole
  token       String              @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId, email])
}

// ─────────────────────────────────────────────
// DEPARTMENTS & TEAMS
// ─────────────────────────────────────────────

model Department {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   DepartmentMember[]
  teams     Team[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model DepartmentMember {
  id           String @id @default(uuid())
  departmentId String
  memberId     String

  department Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  member     WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([departmentId, memberId])
}

model Team {
  id           String   @id @default(uuid())
  workspaceId  String
  departmentId String?
  name         String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department Department?  @relation(fields: [departmentId], references: [id])
  members    TeamMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model TeamMember {
  id       String @id @default(uuid())
  teamId   String
  memberId String

  team   Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
}

// ─────────────────────────────────────────────
// TAGS & LABELS
// ─────────────────────────────────────────────

model Tag {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String   @default("#94a3b8")
  createdAt   DateTime @default(now())

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  ContactTagAssignment[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Label {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String   @default("#94a3b8")
  createdAt   DateTime @default(now())

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations ConversationLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────
// CUSTOM FIELDS
// ─────────────────────────────────────────────

model CustomFieldDefinition {
  id          String          @id @default(uuid())
  workspaceId String
  entityType  String
  name        String
  key         String
  type        CustomFieldType
  options     Json?
  isRequired  Boolean         @default(false)
  isVisible   Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    ContactCustomFieldValue[]

  @@unique([workspaceId, entityType, key])
  @@index([workspaceId, entityType])
}

model ContactCustomFieldValue {
  id        String   @id @default(uuid())
  contactId String
  fieldId   String
  value     Json
  updatedAt DateTime @updatedAt

  contact Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  field   CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([contactId, fieldId])
  @@index([contactId])
}

// ─────────────────────────────────────────────
// CONTACTS
// ─────────────────────────────────────────────

model Contact {
  id           String        @id @default(uuid())
  workspaceId  String
  firstName    String
  lastName     String?
  phone        String
  email        String?
  company      String?
  jobTitle     String?
  avatarUrl    String?
  status       ContactStatus @default(ACTIVE)
  assignedToId String?
  source       LeadSource?
  notes        String?
  mergedIntoId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customValues  ContactCustomFieldValue[]
  tags          ContactTagAssignment[]
  contactNotes  ContactNote[]
  timeline      ContactTimelineEvent[]
  leads         Lead[]
  deals         ContactDeal[]
  conversations Conversation[]
  tasks         Task[]

  @@unique([workspaceId, phone])
  @@index([workspaceId])
  @@index([workspaceId, email])
  @@index([workspaceId, company])
  @@index([workspaceId, deletedAt])
}

model ContactTagAssignment {
  id        String   @id @default(uuid())
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([contactId])
}

model ContactNote {
  id          String   @id @default(uuid())
  contactId   String
  authorId    String
  workspaceId String
  content     String
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([workspaceId])
}

model ContactTimelineEvent {
  id          String   @id @default(uuid())
  contactId   String
  workspaceId String
  eventType   String
  title       String
  description String?
  metadata    Json?
  actorId     String?
  createdAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt(sort: Desc)])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────
// LEADS & PIPELINES
// ─────────────────────────────────────────────

model Pipeline {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  leads     Lead[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  name        String
  color       String   @default("#6366f1")
  sortOrder   Int
  probability Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, name])
  @@index([pipelineId])
}

model Lead {
  id           String     @id @default(uuid())
  workspaceId  String
  contactId    String
  pipelineId   String
  stageId      String
  assignedToId String?
  title        String
  score        Int        @default(0)
  status       LeadStatus @default(NEW)
  source       LeadSource @default(MANUAL)
  followUpAt   DateTime?
  followUpNote String?
  convertedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact    Contact       @relation(fields: [contactId], references: [id])
  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id])
  stage      PipelineStage @relation(fields: [stageId], references: [id])
  assignedTo User?         @relation("LeadAssignee", fields: [assignedToId], references: [id])
  history    LeadHistory[]

  @@index([workspaceId])
  @@index([workspaceId, stageId])
  @@index([workspaceId, assignedToId])
  @@index([workspaceId, status])
}

model LeadHistory {
  id        String   @id @default(uuid())
  leadId    String
  actorId   String?
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────
// DEALS
// ─────────────────────────────────────────────

model DealPipeline {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    DealStage[]
  deals     Deal[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model DealStage {
  id          String   @id @default(uuid())
  pipelineId  String
  name        String
  color       String   @default("#6366f1")
  sortOrder   Int
  probability Int      @default(0)
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline DealPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, name])
  @@index([pipelineId])
}

model Deal {
  id                String     @id @default(uuid())
  workspaceId       String
  pipelineId        String
  stageId           String
  assignedToId      String?
  title             String
  value             Decimal    @default(0) @db.Decimal(15, 2)
  currency          String     @default("USD")
  probability       Int        @default(0)
  status            DealStatus @default(OPEN)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline   DealPipeline @relation(fields: [pipelineId], references: [id])
  stage      DealStage    @relation(fields: [stageId], references: [id])
  assignedTo User?        @relation("DealAssignee", fields: [assignedToId], references: [id])
  contacts   ContactDeal[]
  tasks      Task[]
  notes      DealNote[]
  history    DealHistory[]

  @@index([workspaceId])
  @@index([workspaceId, stageId])
  @@index([workspaceId, assignedToId])
  @@index([workspaceId, status])
}

model ContactDeal {
  id        String @id @default(uuid())
  contactId String
  dealId    String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([contactId, dealId])
}

model DealNote {
  id        String   @id @default(uuid())
  dealId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model DealHistory {
  id        String   @id @default(uuid())
  dealId    String
  actorId   String?
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────
// WHATSAPP — CONVERSATIONS & MESSAGES
// ─────────────────────────────────────────────

model Conversation {
  id                   String             @id @default(uuid())
  workspaceId          String
  contactId            String
  assignedToId         String?
  status               ConversationStatus @default(OPEN)
  isPinned             Boolean            @default(false)
  isArchived           Boolean            @default(false)
  unreadCount          Int                @default(0)
  lastMessageAt        DateTime?
  lastMessageText      String?
  whatsappPhoneNumberId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact       Contact             @relation(fields: [contactId], references: [id])
  assignedTo    User?               @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  messages      Message[]
  labels        ConversationLabel[]
  internalNotes InternalNote[]

  @@unique([workspaceId, contactId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, assignedToId])
  @@index([workspaceId, lastMessageAt(sort: Desc)])
}

model ConversationLabel {
  id             String @id @default(uuid())
  conversationId String
  labelId        String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([conversationId, labelId])
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  workspaceId    String
  senderId       String?
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  status         MessageStatus    @default(PENDING)
  body           String?
  mediaUrl       String?
  mediaMimeType  String?
  mediaSize      Int?
  mediaCaption   String?
  mediaFileName  String?
  templateName   String?
  templateVars   Json?
  whatsappMsgId  String?          @unique
  scheduledAt    DateTime?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  failureReason  String?
  isInternal     Boolean          @default(false)
  replyToId      String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation("MessageSender", fields: [senderId], references: [id])
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id])
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@index([whatsappMsgId])
  @@index([scheduledAt])
}

model InternalNote {
  id             String   @id @default(uuid())
  conversationId String
  authorId       String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model QuickReply {
  id          String   @id @default(uuid())
  workspaceId String
  title       String
  content     String
  shortcut    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model MessageTemplate {
  id            String   @id @default(uuid())
  workspaceId   String
  name          String
  language      String   @default("en")
  category      String
  status        String   @default("PENDING")
  headerText    String?
  bodyText      String
  footerText    String?
  buttons       Json?
  whatsappTplId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name, language])
  @@index([workspaceId])
}

model Broadcast {
  id              String          @id @default(uuid())
  workspaceId     String
  name            String
  templateId      String?
  templateVars    Json?
  filterCriteria  Json?
  recipientCount  Int             @default(0)
  sentCount       Int             @default(0)
  failedCount     Int             @default(0)
  status          BroadcastStatus @default(DRAFT)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipients BroadcastRecipient[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model BroadcastRecipient {
  id            String        @id @default(uuid())
  broadcastId   String
  contactId     String
  status        MessageStatus @default(PENDING)
  messageId     String?
  sentAt        DateTime?
  failureReason String?

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([broadcastId, status])
}

// ─────────────────────────────────────────────
// TASKS & CALENDAR
// ─────────────────────────────────────────────

model Task {
  id           String       @id @default(uuid())
  workspaceId  String
  title        String
  description  String?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  dueAt        DateTime?
  assignedToId String?
  createdById  String
  contactId    String?
  leadId       String?
  dealId       String?
  remindAt     DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy  User      @relation("TaskCreator", fields: [createdById], references: [id])
  contact    Contact?  @relation(fields: [contactId], references: [id])
  deal       Deal?     @relation(fields: [dealId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, assignedToId])
  @@index([workspaceId, status])
  @@index([dueAt])
}

model CalendarEvent {
  id          String   @id @default(uuid())
  workspaceId String
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  location    String?
  color       String?
  createdById String
  contactId   String?
  leadId      String?
  dealId      String?
  externalId  String?
  remindAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                   @relation(fields: [createdById], references: [id])
  attendees CalendarEventAttendee[]

  @@index([workspaceId])
  @@index([workspaceId, startAt])
}

model CalendarEventAttendee {
  id      String @id @default(uuid())
  eventId String
  userId  String

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id          String           @id @default(uuid())
  workspaceId String
  userId      String
  type        NotificationType
  title       String
  body        String?
  link        String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, isRead])
  @@index([workspaceId, userId, createdAt(sort: Desc)])
}

model NotificationPreference {
  id          String              @id @default(uuid())
  userId      String
  workspaceId String
  type        NotificationType
  channel     NotificationChannel
  isEnabled   Boolean             @default(true)
  updatedAt   DateTime            @updatedAt

  @@unique([userId, workspaceId, type, channel])
  @@index([userId, workspaceId])
}

// ─────────────────────────────────────────────
// AI USAGE LOGS
// ─────────────────────────────────────────────

model AiUsageLog {
  id               String     @id @default(uuid())
  workspaceId      String
  userId           String?
  provider         AIProvider
  feature          String
  model            String
  promptTokens     Int        @default(0)
  completionTokens Int        @default(0)
  totalTokens      Int        @default(0)
  latencyMs        Int?
  success          Boolean    @default(true)
  error            String?
  createdAt        DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id          String      @id @default(uuid())
  workspaceId String
  userId      String?
  action      AuditAction
  resource    String
  resourceId  String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, userId])
  @@index([workspaceId, resource, resourceId])
}

// ─────────────────────────────────────────────
// SETTINGS & API KEYS
// ─────────────────────────────────────────────

model WorkspaceSettings {
  id                 String      @id @default(uuid())
  workspaceId        String      @unique
  wabPhoneNumberId   String?
  wabAccessToken     String?
  wabWebhookSecret   String?
  wabVerifyToken     String?
  aiProvider         AIProvider?
  aiApiKey           String?
  aiModel            String?
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPassword       String?
  smtpFromEmail      String?
  smtpFromName       String?
  enforce2FA         Boolean     @default(false)
  sessionTimeoutMins Int         @default(1440)
  ipWhitelist        String[]    @default([])
  updatedAt          DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([keyHash])
}
