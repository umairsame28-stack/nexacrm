# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_NAME=NexaCRM
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://nexacrm:password@localhost:5432/nexacrm_dev?schema=public

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─────────────────────────────────────────────
# JWT (RS256 — generate with: openssl genrsa -out private.pem 2048)
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-for-development-only
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG...\n-----END PUBLIC KEY-----
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_COOKIE_NAME=nexacrm_refresh

# ─────────────────────────────────────────────
# Encryption
# ─────────────────────────────────────────────
APP_ENCRYPTION_KEY=32-character-hex-key-for-aes-256-gcm-encryption

# ─────────────────────────────────────────────
# AWS S3 / MinIO
# ─────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=nexacrm-media
AWS_S3_ENDPOINT=http://localhost:9000
# Set AWS_S3_ENDPOINT to http://localhost:9000 for MinIO in dev

# ─────────────────────────────────────────────
# Email (SMTP)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@nexacrm.io
SMTP_FROM_NAME=NexaCRM

# ─────────────────────────────────────────────
# WhatsApp (Meta Cloud API) — global defaults
# ─────────────────────────────────────────────
META_WHATSAPP_API_URL=https://graph.facebook.com/v20.0
META_WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ─────────────────────────────────────────────
# Throttling
# ─────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=900000
THROTTLE_AUTH_LIMIT=5

# ─────────────────────────────────────────────
# Bull Queue
# ─────────────────────────────────────────────
BULL_REDIS_URL=redis://localhost:6379
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json
